<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cloneCT.user.mapper.UserMapper">

    <select id="login" parameterType="com.cloneCT.user.dto.LoginRequest" resultType="com.cloneCT.user.dto.UserDto">
        SELECT 
            user_id      AS userId,
            name         AS name,
            email        AS email,
            phone_number AS phoneNumber
        FROM doram01_users
        WHERE email = #{email}
        AND password = #{password}
    </select>

</mapper>